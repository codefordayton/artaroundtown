DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# DigitalOcean App Platform injects DATABASE_URL from the attached database.
# For local dev, SQLite is used by default.
DATABASE_URL=sqlite:///db.sqlite3

# Media files: DigitalOcean Spaces (S3-compatible) in production, local in dev.
USE_S3_STORAGE=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_CUSTOM_DOMAIN=

# Email: console backend in dev, Brevo (via django-anymail) in production.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@artaroundtowndayton.org
ADMIN_EMAIL=
