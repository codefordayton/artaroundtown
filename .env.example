DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway provides DATABASE_URL automatically in production
# For local dev, SQLite is used by default
DATABASE_URL=sqlite:///db.sqlite3

USE_S3_STORAGE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_CUSTOM_DOMAIN=

# Email — console backend in dev, SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@artaroundtowndayton.org

# Digital Ocean - Object storage via spaces 
BUCKET_NAME = "artaroundtown"
BUCKET_BASE_PATH = "https://nyc3.digitaloceanspaces.com"
DIGITAL_OCEAN_PERSONAL_ACCESS_TOKEN=
DIGITAL_OCEAN_SECRET_KEY=

